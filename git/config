[user]
	name = Egor Duplensky
	email = egor.duplensky@gmail.com
[github]
    user = EgorDuplensky
[gitlab]
    user = eduplens
[credential]
    helper = store
[core]
    askPass =
    editor = emacsclient
    pager = less -FXR
[color]
    branch = auto
    diff = auto
    status = auto
    interactive = auto
    log = auto
[alias]
    amend = commit -a --amend --date=now -C HEAD
[color "show"]
    tag = red
[diff]
    tool = kdiff3
[merge]
    tool = kdiff3
[difftool]
    prompt = false
[submodule]
	recurse = true
[pull]
	rebase = true
[include]
	path = custom_config
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
