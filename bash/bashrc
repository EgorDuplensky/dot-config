#!/usr/bin/env bash
# shellcheck disable=SC1090,SC2155
# source environment specific configuration first

is_interactive_shell=false
if [[ $- == *i* ]]; then
    is_interactive_shell=true
fi

# if interactive
if $is_interactive_shell; then
    bind '"\C-x\C-r": repeat'
fi

if [[ -f ~/.config/bash/oh-my-bash ]]; then
    . ~/.config/bash/oh-my-bash
else
    # Default Ubuntu prompt
    # set variable identifying the chroot you work in (used in the prompt below)
    if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
        debian_chroot=$(cat /etc/debian_chroot)
    fi
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
    # Prepend terminal title
    case "$TERM" in
        xterm*|rxvt*)
            PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
            ;;
    esac
fi

set +o noclobber

# enter the context
[ -f ~/.config/bash/.context ] && source ~/.config/bash/.context

if [[ ! "$PATH" == ${HOME}/.local/bin* ]]; then
  export PATH="${PATH:+${PATH}:}${HOME}/.local/bin"
fi

if [[ ! "$PATH" == *${HOME}/.scripts* ]]; then
  export PATH="${PATH:+${PATH}:}${HOME}/.scripts"
fi

if [[ ! "$PATH" == ${HOME}/go/bin* ]]; then
  export PATH="${PATH:+${PATH}:}${HOME}/go/bin"
fi

# shopt -s direxpand

[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion

[ -d ~/.config/bash/bash_completion.d ] && for f in ~/.config/bash/bash_completion.d/*; do
    source "${f}"
done

# custom functions
[ -f ~/.config/bash/functions.sh ] && source ~/.config/bash/functions.sh

export XDG_CURRENT_DESKTOP=GNOME

export XDG_CONFIG_HOME=~/.config
export XDG_RUNTIME_DIR=/run/user/$(id -u)
# remove stamps from history
unset HISTTIMEFORMAT
unset HIST_STAMPS
# unlimited history
HISTSIZE=
HISTFILESIZE=
# avoid duplication in bash history
export HISTCONTROL='ignoreboth'
shopt -s histappend
# ensure utf8
export LANG=en_US.UTF-8
export LC_TIME=en_US.UTF-8
export LC_COLLATE=en_US.UTF-8
export LC_MESSAGES=en_US.UTF-8
export LANGUAGE=en_US.UTF-8

if command -v emacsclient > /dev/null; then
    export EDITOR="emacsclient --no-wait"
    export VISUAL="emacsclient"
fi

export GOPATH=~/go

if [[ is_interactive_shell == true ]]; then
    # hide dwm name from jvm. Otherwise jwm complains about window manager
    # and refuses to run from dwm.
    if command -v wmname > /dev/null; then wmname LG3D; fi
fi

# less/man colors
export LESS=-R
export LESS_TERMCAP_mb="$(printf '%b' '[1;31m')"; a="${a%_}"
export LESS_TERMCAP_md="$(printf '%b' '[1;36m')"; a="${a%_}"
export LESS_TERMCAP_me="$(printf '%b' '[0m')"; a="${a%_}"
export LESS_TERMCAP_so="$(printf '%b' '[01;44;33m')"; a="${a%_}"
export LESS_TERMCAP_se="$(printf '%b' '[0m')"; a="${a%_}"
export LESS_TERMCAP_us="$(printf '%b' '[1;32m')"; a="${a%_}"
export LESS_TERMCAP_ue="$(printf '%b' '[0m')"; a="${a%_}"
[ -f ~/.dircolors ] && eval "$(dircolors ~/.dircolors)"

# emacs26 need
export ALTERNATE_EDITOR=""

# to prevent any ugly gui popup
export SSH_ASKPASS=""

# common aliases
alias grep="grep --color=auto"
alias ll='ls -lah --color --group-directories-first'
alias ls='ls --color --group-directories-first'
alias ec='/usr/local/bin/emacsclient --no-wait'
alias et='/usr/local/bin/emacsclient -t'
alias sudoec='SUDO_EDITOR=/usr/local/bin/emacsclient sudoedit'
alias cls='printf "\033c"; stty sane'
alias pronounce='trans -speak -no-translate -j'
alias translate='trans -d -v :ru -j'
alias google-chrome='google-chrome-stable --enable-features=WebUIDarkMode --force-dark-mode'
alias file-explorer='xdg-open /'

if command -v fdfind > /dev/null; then alias fd='fdfind'; fi

if $is_interactive_shell; then
    # Bind undo to just C-u instead of C-x C-u
    stty kill undef
    bind '"\C-u":undo'
fi

[ -d ~/.config/bash/bash_aliases.d ] && for f in ~/.config/bash/bash_aliases.d/*; do
    source "${f}"
done

# fzf configuration
#[ -f ~/git/ble.sh/out/ble.sh ] && source ~/git/ble.sh/out/ble.sh
# fzf configuration
[ -f ~/.config/bash/fzf.bash ] && source ~/.config/bash/fzf.bash
# this is a secret
[ -f ~/.config/bash/.bash_secret ] && source ~/.config/bash/.bash_secret
# fzf-fasd configuration
# [ -f ~/.config/bash/fasd.bash ] && source ~/.config/bash/fasd.bash

if [[ "$TERM" == "dumb" ]]; then
    PS1="> "
    PROMPT_COMMAND=""
fi

[ -f ~/.bash_aliases ] && . ~/.bash_aliases
[ -f ~/.bashrc_work ] && . ~/.bashrc_work

if [[ "$INSIDE_EMACS" == 'vterm' ]] \
&& [[ -n ${EMACS_VTERM_PATH} ]] \
&& [[ -f ${EMACS_VTERM_PATH}/etc/emacs-vterm-bash.sh ]]; then
    . "${EMACS_VTERM_PATH}/etc/emacs-vterm-bash.sh"
    # oh-my-bash theme rebuilds PS1 from scratch each prompt, so the
    # PS1 append in emacs-vterm-bash.sh gets overwritten.  Explicitly
    # hook vterm_prompt_end via PROMPT_COMMAND instead.
    PROMPT_COMMAND="vterm_prompt_end; ${PROMPT_COMMAND}"
fi

export PATH=/usr/local/cuda/bin:$PATH
export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

export NVM_DIR="$HOME/.config/nvm"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
# [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"  # This loads nvm

# Claude code
if command -v claude > /dev/null; then
    export ENABLE_LSP_TOOL=1
    export CLAUDE_ENV_FILE="$HOME/.claude/env.sh"
    export CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1
fi

